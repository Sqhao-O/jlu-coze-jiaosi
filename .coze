[project]
requires = ["python-3.12"]
project_type = "backend"

[preview]
preview_enable = "enabled"

[dev]
build = ["bash", "projects/scripts/setup.sh"]
run = ["bash", "projects/scripts/http_run.sh"]

[deploy]
build = ["bash", "projects/scripts/setup.sh"]
run = ["bash", "projects/scripts/http_run.sh"]

[subprojects]
path = ["projects"]
