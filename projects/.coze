[project]
sub_id = "41cf8f3b"
name = "vibe-coding"
entrypoint = "src/main.py"
requires = ["python-3.12"]
project_type = "web"

[preview]
preview_enable = "enabled"

[dev]
build = ["bash", "scripts/setup.sh"]
run = ["bash", "scripts/http_run.sh"]
pack = ["bash", "scripts/pack.sh"]

[deploy]
build = ["bash", "scripts/setup.sh"]
run = ["bash", "scripts/http_run.sh", "-p", "5000"]
deps = ["git"]

[deploy.profile]
kind = "service"
flavor = "web"

[deploy.backend]
enabled = true
